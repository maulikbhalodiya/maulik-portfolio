{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"defaultFontSizes": false,
		"defaultSpacingSizes": false,
		"defaultGradients": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"color": "#0b0b0d",
					"name": "Base"
				},
				{
					"slug": "surface",
					"color": "#141418",
					"name": "Surface"
				},
				{
					"slug": "text",
					"color": "#e8e6e3",
					"name": "Text"
				},
				{
					"slug": "muted",
					"color": "#9a9691",
					"name": "Muted"
				},
				{
					"slug": "accent",
					"color": "#f0a868",
					"name": "Accent"
				},
				{
					"slug": "accent-strong",
					"color": "#e0894a",
					"name": "Accent Strong"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem"
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "clamp(2rem, 1.4rem + 2.6vw, 3rem)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{
					"slug": "30",
					"name": "1: Compact",
					"size": "0.5rem"
				},
				{
					"slug": "50",
					"name": "2: Tight",
					"size": "1rem"
				},
				{
					"slug": "70",
					"name": "3: Standard",
					"size": "2rem"
				},
				{
					"slug": "80",
					"name": "4: Roomy",
					"size": "4rem"
				}
			]
		},
		"layout": {
			"contentSize": "48rem",
			"wideSize": "72rem"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)",
				"top": "0",
				"bottom": "0"
			},
			"blockGap": "var(--wp--preset--spacing--70)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-strong)"
					}
				}
			}
		}
	}
}