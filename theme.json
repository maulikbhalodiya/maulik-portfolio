{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"customDuotone": false,
			"link": true,
			"palette": [
				{
					"slug": "base",
					"color": "#0a0a0b",
					"name": "Base"
				},
				{
					"slug": "black",
					"color": "#000000",
					"name": "Pure Black"
				},
				{
					"slug": "surface",
					"color": "#111113",
					"name": "Surface"
				},
				{
					"slug": "surface-2",
					"color": "#171719",
					"name": "Surface Raised"
				},
				{
					"slug": "paper",
					"color": "#f8f7f0",
					"name": "Editorial Ground"
				},
				{
					"slug": "paper-warm",
					"color": "#fffdf4",
					"name": "Editorial Cream"
				},
				{
					"slug": "text",
					"color": "#fffdf4",
					"name": "Text on Dark"
				},
				{
					"slug": "text-muted",
					"color": "#d8d5ca",
					"name": "Text Secondary"
				},
				{
					"slug": "text-faint",
					"color": "#77746c",
					"name": "Text Muted"
				},
				{
					"slug": "text-on-paper",
					"color": "#0a0a0b",
					"name": "Text on Light"
				},
				{
					"slug": "accent",
					"color": "#facc15",
					"name": "Signal Amber (dark surfaces only)"
				},
				{
					"slug": "accent-hover",
					"color": "#fde047",
					"name": "Signal Amber Hover"
				},
				{
					"slug": "accent-on-paper",
					"color": "#0a0a0b",
					"name": "Ink on Paper (light surfaces only)"
				},
				{
					"slug": "line",
					"color": "#262626",
					"name": "Hairline Dark"
				},
				{
					"slug": "line-strong",
					"color": "#343434",
					"name": "Hairline Emphasis"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": true,
			"dropCap": false,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "Syne, system-ui, -apple-system, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Plus Jakarta Sans\", system-ui, -apple-system, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Technical Metadata",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem"
				},
				{
					"slug": "x-large",
					"name": "Display",
					"size": "clamp(2.25rem, 1.5rem + 3vw, 3rem)"
				},
				{
					"slug": "hero",
					"name": "Hero",
					"size": "clamp(2.25rem, 1.4rem + 3.6vw, 3.75rem)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"padding": true,
			"margin": true,
			"blockGap": true,
			"customSpacingSize": true,
			"units": [ "px", "rem", "em", "vw", "%" ],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Hairline",
					"size": "0.25rem"
				},
				{
					"slug": "30",
					"name": "Micro",
					"size": "0.5rem"
				},
				{
					"slug": "40",
					"name": "Compact",
					"size": "1rem"
				},
				{
					"slug": "50",
					"name": "Standard",
					"size": "1.5rem"
				},
				{
					"slug": "60",
					"name": "Roomy",
					"size": "2.5rem"
				},
				{
					"slug": "70",
					"name": "Section",
					"size": "4rem"
				},
				{
					"slug": "80",
					"name": "Section Large",
					"size": "6rem"
				}
			]
		},
		"border": {
			"color": true,
			"radius": false,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false
		},
		"dimensions": {
			"minHeight": true
		},
		"position": {
			"sticky": false
		},
		"layout": {
			"contentSize": "90rem",
			"wideSize": "90rem"
		},
		"custom": {
			"grid": {
				"dark": "48px",
				"sub": "32px",
				"cream": "96px",
				"warm": "64px"
			},
			"motion": {
				"fast": "200ms",
				"ease": "cubic-bezier(0.4, 0, 0.2, 1)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|text"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|50",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "1.5rem",
				"right": "1.5rem"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.5"
		},
		"border": {
			"color": "var:preset|color|line",
			"style": "solid",
			"width": "0"
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|text" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "800",
					"lineHeight": "1.08",
					"letterSpacing": "-0.025em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|hero",
					"lineHeight": "1.06",
					"letterSpacing": "-0.025em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "700",
					"lineHeight": "1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700",
					"lineHeight": "1.4"
				}
			},
			"link": {
				"color": { "text": "var:preset|color|accent" },
				"typography": { "textDecoration": "none" },
				":visited": {
					"color": { "text": "var:preset|color|accent" }
				},
				":hover": {
					"color": { "text": "var:preset|color|accent-hover" }
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "2px",
						"offset": "3px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|black"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"lineHeight": "1.4286",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":visited": {
					"color": {
						"background": "var:preset|color|accent",
						"text": "var:preset|color|black"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-hover",
						"text": "var:preset|color|black"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "2px",
						"offset": "3px"
					}
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|text-faint" },
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.4286"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "700",
					"fontSize": "1.125rem",
					"lineHeight": "1.5556",
					"letterSpacing": "-0.025em"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontWeight": "500",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.4286"
				}
			},
			"core/code": {
				"color": {
					"text": "var:preset|color|text",
					"background": "var:preset|color|surface"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono"
				},
				"border": {
					"color": "var:preset|color|line",
					"style": "solid",
					"width": "1px"
				}
			},
			"core/separator": {
				"color": { "text": "var:preset|color|line" }
			},
			"core/quote": {
				"border": {
					"color": "var:preset|color|accent",
					"style": "solid",
					"width": "3px 0 3px 0"
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var:preset|color|accent",
					"style": "solid",
					"width": "3px 0 3px 0"
				}
			}
		}
	}
}
