{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "maulik-portfolio/portfolio-list",
	"version": "0.5.0",
	"title": "Portfolio List",
	"category": "portfolio",
	"icon": "grid-view",
	"description": "A grid of published projects, read from the project post type. Dynamic, so a new project appears without editing this block again.",
	"keywords": [ "projects", "portfolio", "grid", "work", "case studies" ],
	"textdomain": "maulik-portfolio",
	"attributes": {
		"count": {
			"type": "number",
			"default": 6
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		},
		"order": {
			"type": "string",
			"default": "date"
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false,
		"interactivity": true
	},
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js",
	"editorScript": [ "file:./edit.js", "file:./index.js" ]
}